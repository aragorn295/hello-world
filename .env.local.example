# Copy to .env.local and fill in to switch from mocks to real services.
# Any variable left unset falls back to the built-in mock.

# Anthropic Claude — used for insight extraction.
# Without this, a deterministic mock produces plausible insights.
ANTHROPIC_API_KEY=

# OpenAI Whisper — used for transcription.
# Without this, a mock transcript is generated.
OPENAI_API_KEY=

# Supabase — for persistent storage and real auth.
# Without this, data is kept in browser localStorage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NextAuth (Google / Meta). Without these the app uses a demo login.
NEXTAUTH_URL=
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
